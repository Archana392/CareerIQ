# ====================================================================
# CAREERIQ ENVIRONMENT CONFIGURATION
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing JWT authentication tokens (fallback auth)
JWT_SECRET="careeriq_jwt_secret_token_key_dev"

# --------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# --------------------------------------------------------------------
# 1. Obtain your Project URL and Anon/Publishable Key from:
#    Supabase Dashboard -> Settings -> API
# 2. Execute 'supabase/schema.sql' in the Supabase Dashboard SQL Editor
#    to create all relational tables, RLS policies, and storage buckets.

# Server-Side Supabase Variables:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Client-Side (Vite) Supabase Variables:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
